DISCORD_TOKEN=your_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Port untuk Web Dashboard & Healthcheck (Default: 8080)
PORT=8080

# Lokasi penyimpanan database SQLite (Default Docker: /app/data/voice_tracker.db)
DB_PATH=/app/data/voice_tracker.db

# Opsional: Base64 string dari cookies.txt jika YouTube memblokir IP server/VPS
# YOUTUBE_COOKIES_BASE64=

